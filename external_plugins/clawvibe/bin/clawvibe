#!/usr/bin/env bash
# clawvibe — CLI for the ClawVibe channel plugin.
set -euo pipefail

SELF="$(readlink -f "${BASH_SOURCE[0]}")"
PLUGIN_DIR="$(cd "$(dirname "$SELF")/.." && pwd)"

usage() {
  cat <<EOF
clawvibe — ClawVibe channel plugin CLI

usage: clawvibe <command>

  setup [--apply-tailscale]      One-shot install: bundle, CLI link, Tailscale
                                 ingress check, start configured agents.
  agent add <id> [--emoji E] [--model M] [--prompt P]
                                 Define + configure a channel agent.
  agent rm <id> [--purge]        Unconfigure an agent (--purge deletes its def).
  agent list                     Show configured agents and their status.
  agents up                      Start every configured agent (idempotent).
  agents down                    Stop all clawvibe-* agent sessions.
  agents restart                 down + stop the gateway daemon + up (use after upgrading).
  doctor                         Diagnose install, PATH, ingress, gateway and agent problems.
  tailscale-check                Check the :8791 ingress is a TLS-terminated TCP forward.
  install-service                systemd --user unit that runs 'agents up' at login/boot.
  qr [--text] [--no-wait]        Generate a pairing QR code.
  help                           This message.
EOF
}

need() {
  command -v "$1" >/dev/null 2>&1 && return 0
  echo "clawvibe: '$1' is required but not on PATH — $2" >&2
  return 1
}

cmd="${1:-help}"
shift || true

case "$cmd" in
  qr)
    need bun "install it from https://bun.sh" || exit 127
    need python3 "install python3 (the QR renderer needs it)" || exit 127
    # Warn (non-blocking) if the Tailscale ingress can't carry WebSockets — the
    # most common cause of "paired but won't connect".
    bun "$PLUGIN_DIR/cli.ts" tailscale-check || true
    exec python3 "$PLUGIN_DIR/qr.py" "$@"
    ;;
  setup|install-service|agent|agents|doctor|tailscale-check)
    need bun "install it from https://bun.sh" || exit 127
    exec bun "$PLUGIN_DIR/cli.ts" "$cmd" "$@"
    ;;
  help|-h|--help)
    usage
    ;;
  *)
    echo "unknown command: $cmd" >&2
    usage
    exit 1
    ;;
esac
